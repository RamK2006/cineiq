# CineIQ backend development environment
# Copy this file to backend/.env and replace credentials as needed.

ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=[]
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
MAX_ROOM_PARTICIPANTS=10

# Local PostgreSQL installed directly on Windows
DATABASE_URL=postgresql+asyncpg://cineiq:cineiq_secret@localhost:5432/cineiq

UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_JWT_AUDIENCE=
CLERK_AUDIENCE=

TMDB_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
